/*
 * FSE Display 3.5" – HX8357 over SPI2
 * SPDX-License-Identifier: Apache-2.0
 *
 * Pluggable display for the DCU board. Carries the panel and the bus only;
 * the controls come from the fse_dcu_2612 shield.
 *
 * Connector:
 *   Pin 31  Data/Command  -> PB13
 *   Pin 32  Serial Clock  -> PB10
 *
 * The 2.8" display uses the same two pins the other way round, which is why
 * each display shield brings its own SPI2 pin assignment.
 *
 * Further connections:
 *   CS    -> PA12  (GPIO, active low)
 *   RESET -> PD2   (active low)
 */

#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>

/ {
	chosen {
		zephyr,display = &hx8357_fse;
	};

	/*
	 * MIPI DBI is the abstraction layer between the Zephyr display API and
	 * the actual SPI bus. It manages the DC GPIO and the reset line.
	 */
	mipi_dbi_fse_display_3_5: mipi_dbi_fse_display_3_5 {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;

		/* DC pin: high = data, low = command */
		dc-gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;

		/* Reset: low pulse during init */
		reset-gpios = <&gpiod 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		/*
		 * write-only: the HX8357 can be read in principle, but most
		 * designs are wired write-only (saves the MISO line). Remove
		 * this if a shield routes MISO through.
		 */
		write-only;

		#address-cells = <1>;
		#size-cells = <0>;

		hx8357_fse: hx8357@0 {
			compatible = "himax,hx8357";
			reg = <0>; /* CS index: the first entry in cs-gpios */

			/*
			 * HX8357-D SPI clock limit: the datasheet states a cycle
			 * time of >= 66 ns (approx. 15.1 MHz) for the parallel
			 * interface mode. In SPI mode real panels tolerate far
			 * higher rates:
			 *   25 MHz – safe, recommended starting point
			 *   40 MHz – works on short traces (worth trying)
			 *   60 MHz – possible with good routing
			 * Step back down if artefacts or corruption appear.
			 */
			mipi-max-frequency = <40000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";

			/* Display geometry: the HX8357-D is natively 320x480 */
			width = <320>;
			height = <480>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;

			/*
			 * Orientation: 0 = portrait (the default).
			 * Other options: 90 / 180 / 270.
			 */
			rotation = <90>;

			/*
			 * display-inversion: the HX8357-D is a "normally white"
			 * panel. Without inversion white comes out dark purple and
			 * black greenish. INVON corrects the polarity.
			 */
			display-inversion;

			red-blue-swap;

			/* -------------------------------------------------------
			 * HX8357-D initialisation registers
			 * All values match the Adafruit-validated defaults from
			 * the himax,hx8357.yaml binding and can be overridden here
			 * per board.
			 * ------------------------------------------------------- */

			/*
			 * SETEXTC (0xB9): unlock key for the extended command
			 * set. Do not change.
			 */
			setextc = [ff 83 57];

			/*
			 * SETOSC (0xB0): internal oscillator / frame rate.
			 * 0x68 -> 70 Hz in normal mode, 55 Hz in idle mode.
			 */
			setosc = [68];

			/*
			 * SETPWR1 (0xB1): supply voltages (AVDD, AVEE, VGH, VGL).
			 * Values from the manufacturer's init example (16-bit RGB565):
			 *   Byte 1: 0x16 (VSPR step, marginally off the Adafruit default 0x15)
			 *   Byte 4: 0xC3 (AP – op-amp bias current, higher than Adafruit's 0x83)
			 *   Byte 5: 0x5C (FS – source driver frequency doubler, manufacturer default)
			 */
			setpwr1 = [00 16 1c 1c c3 5c];

			/*
			 * SETRGB (0xB3): SPI interface configuration.
			 * Byte 0 bit 7 (SDO_EN): 0 = SDO/MISO tri-stated (write-only,
			 * consistent with the write-only property on the MIPI DBI node).
			 * Change to [80 00 06 06] AND drop write-only if reads from
			 * the display are ever needed.
			 */
			setrgb = [00 00 06 06];

			/*
			 * SETCYC (0xB4): display timing (back/front porch, pixel clock).
			 * Byte 0: inversion mode.
			 *   0x02 = column inversion (Adafruit default)
			 *   0x32 = 2-dot inversion (manufacturer example code)
			 * Switch to 0x32 if flicker or striping shows up.
			 */
			setcyc = [02 40 00 2a 2a 0d 78];

			/*
			 * SETCOM (0xB6): VCOM voltage.
			 * 0x40 = manufacturer default from the init example.
			 * 0x25 = Adafruit default (approx. -1.52 V, lower voltage).
			 * Raise it against ghosting, lower it against washed-out colours.
			 */
			setcom = [40];

			/*
			 * SETPANEL (0xCC): panel properties.
			 * 0x05 = BGR panel, gate scan top to bottom, source S1 to S960.
			 * Change to [09] if red and blue come out swapped.
			 */
			setpanel = [05];

			/*
			 * SETSTBA (0xC0): source timing / balance.
			 * Byte 0: 0x70 (N_OPON – normal-mode op-amp current, manufacturer value)
			 *         0x50 = Adafruit default
			 * Byte 4: 0xC8 (STBA – manufacturer value)
			 *         0x1E = Adafruit default
			 */
			setstba = [70 50 01 3c c8 08];

			/*
			 * SETGAMMA (0xE0): gamma correction.
			 * 34 bytes: 17 for the positive, 17 for the negative curve.
			 * Values from the manufacturer's init example (RGB565 mode).
			 * The Adafruit defaults differ in bytes 2, 3, 4, 5, 7, 8, 9, 12.
			 */
			setgamma = [
				02 0a 10 1a 22 34 41 4a 4d
				44 3a 23 19 08 09 03 02 0a
				10 1a 22 34 41 4a 4d 44 3a
				23 19 08 09 03 00 01
			];
		};
	};
};

/*
 * SPI2 node overlay:
 * - Enables the bus (overriding "disabled" from the board DTS)
 * - Adds cs-gpios (shield specific)
 * - Configures DMA for TX and RX (STM32F405RG, DMA1)
 *
 * STM32F405 reference manual, table 43 – DMA1 request mapping:
 *   Stream 4, channel 0 -> SPI2_TX
 *   Stream 3, channel 0 -> SPI2_RX
 *
 * RX DMA is carried along so the STM32 SPI DMA driver can complete its
 * transactions cleanly – even though the display is driven write-only.
 */
&spi2 {
	/* 3.5": connector pin 32 = SCK -> PB10, pin 31 = DC -> PB13 */
	pinctrl-0 = <&spi2_sck_pb10 &spi2_mosi_pc3 &spi2_miso_pc2>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 12 GPIO_ACTIVE_LOW>;
	/* STM32F405 RM table 43: DMA1 stream 4 ch 0 = SPI2_TX, stream 3 ch 0 = SPI2_RX
	 * Cells: <&dmaX stream channel channel-config fifo-threshold>
	 * STM32_DMA_PERIPH_TX = MEMORY_TO_PERIPH | MEM_INC = 0x440
	 * STM32_DMA_PERIPH_RX = PERIPH_TO_MEMORY | MEM_INC = 0x480
	 * STM32_DMA_PRIORITY_HIGH = 0x20000, fifo = 0 (direct mode)
	 */
	dmas = <&dma1 4 0 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH) 0>,
	       <&dma1 3 0 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH) 0>;
	dma-names = "tx", "rx";
	status = "okay";
};

&dma1 {
	status = "okay";
};
