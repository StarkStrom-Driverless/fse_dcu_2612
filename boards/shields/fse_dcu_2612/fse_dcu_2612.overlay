/*
 * FSE DCU 2612 – Driver Control Unit, add-on board for the fse_pb
 * SPDX-License-Identifier: Apache-2.0
 *
 * Describes the controls of the DCU board:
 *   Backlight TIM1_CH4 on PA11
 *   Inputs    2 rotary encoders, 4 buttons (left, right, RTD, reserve)
 *   Outputs   piezo, APA102 LED strip over SPI3
 *   Storage   SPI NOR flash AT25DF081A over SPI1
 *
 * The display is pluggable and comes from a shield of its own — either
 * fse_display_3_5 or fse_display_2_8. Both use the same two connector pins the
 * other way round and therefore bring their own SPI2 pin assignment with them:
 *
 *   west build -b fse_pb --shield "fse_dcu_2612;fse_display_3_5" ...
 *
 * Not here: CAN transceiver, user LEDs and console — those sit on the
 * processor board and belong in the board DTS.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/lvgl/lvgl.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
	/* ── Controls ────────────────────────────────────────────────────────
	 *
	 * Rotary encoders, buttons, piezo and display backlight all sit on the
	 * DCU board, not on the processor board.
	 */

	aliases {
		qdec-input-left = &qdec_input0;
		qdec-input-right = &lvgl_encoder1;
		keypad-left = &keypad_left;
		keypad-right = &keypad_right;
		keypad-rtd = &keypad_rtd;
		/*
		 * The reserve button is the one control that is not routed
		 * through LVGL, so the alias points at the gpio-keys device
		 * itself rather than at a keypad indev — see ui.c.
		 */
		reserve-button = &buttons3;
		piezo = &piezo_gpio;
		pwm-display-bright = &pwm_display_bright;
		led-strip = &apa102;
	};

	leds {
		compatible = "gpio-leds";
		pwm_display_bright: pwm_display_bright {
			gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
		};
		piezo_gpio: piezo_gpio {
			gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Left rotary encoder: screen carousel */
	qdec_input0: qdec-encoder0 {
		compatible = "gpio-qdec";
		gpios = <&gpioc 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			<&gpioc 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		steps-per-period = <2>;
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <2000>;
		idle-timeout-ms = <200>;
		status = "okay";
	};

	/* Right rotary encoder: widget navigation within a screen */
	qdec_input1: qdec-encoder1 {
		compatible = "gpio-qdec";
		gpios = <&gpioa 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			<&gpioa 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		steps-per-period = <2>;
		zephyr,axis = <INPUT_REL_HWHEEL>;
		sample-time-us = <2000>;
		idle-timeout-ms = <200>;
		status = "okay";
	};

	lvgl_encoder0: lvgl-encoder0 {
		compatible = "zephyr,lvgl-encoder-input";
		rotation-input-code = <INPUT_REL_WHEEL>;
		status = "okay";
	};

	lvgl_encoder1: lvgl-encoder1 {
		compatible = "zephyr,lvgl-encoder-input";
		rotation-input-code = <INPUT_REL_HWHEEL>;
		status = "okay";
	};

	buttons0: gpio_keys0 {
		compatible = "gpio-keys";
		left_button: button_1 {
			gpios = <&gpioc 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
	};

	buttons1: gpio_keys1 {
		compatible = "gpio-keys";
		right_button: button_2 {
			gpios = <&gpioc 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
	};

	buttons2: gpio_keys2 {
		compatible = "gpio-keys";
		rtd_button: button_2 {
			gpios = <&gpioc 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
	};

	/*
	 * Reserve button — drives the DCU_RESERVE_BUTTON bit of DCU_2_mABX and
	 * nothing on the display. It has no keypad indev below, because it is
	 * read straight from the input subsystem: it has to work on every
	 * screen, and an LVGL widget would lose the release event when its
	 * screen is torn down while the button is held.
	 */
	buttons3: gpio_keys3 {
		compatible = "gpio-keys";
		reserve_button: button_3 {
			gpios = <&gpiob 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
	};

	keypad_left: keypad0 {
		compatible = "zephyr,lvgl-keypad-input";
		input = <&buttons0>;
		input-codes = <INPUT_KEY_ENTER>;
		lvgl-codes = <LV_KEY_ENTER>;
	};

	keypad_right: keypad1 {
		compatible = "zephyr,lvgl-keypad-input";
		input = <&buttons1>;
		input-codes = <INPUT_KEY_ENTER>;
		lvgl-codes = <LV_KEY_ENTER>;
	};

	keypad_rtd: keypad2 {
		compatible = "zephyr,lvgl-keypad-input";
		input = <&buttons2>;
		input-codes = <INPUT_KEY_ENTER>;
		lvgl-codes = <LV_KEY_ENTER>;
	};

};

/*
 * Display backlight over TIM1_CH4 on PA11.
 *
 * TIM3 is switched off: Zephyr's PWM LED driver would otherwise create a
 * second instance that is not wired up on this board.
 */
&timers3 {
	status = "disabled";
};

&timers1 {
	status = "okay";

	pwm1: pwm {
		pinctrl-0 = <&tim1_ch4_pa11>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/*
 * APA102 LED strip in the driver's field of view above the display.
 *
 * The board DTS carries the bus with its pinctrl but leaves it disabled — what
 * the connector pins actually do is for the shield to decide.
 */
&spi3 {
	pinctrl-0 = <&spi3_sck_pc10 &spi3_mosi_pc12>;
	pinctrl-names = "default";
	status = "okay";

	apa102: apa102@0 {
		compatible = "apa,apa102";
		reg = <0>;
		spi-max-frequency = <5250000>;
		chain-length = <28>;
		color-mapping = <LED_COLOR_ID_BLUE LED_COLOR_ID_GREEN LED_COLOR_ID_RED>;
	};
};

/*
 * External SPI NOR flash AT25DF081A (8 Mbit = 1 MB) on SPI1.
 *
 * Home of the persistent settings. The internal flash is a poor fit: its
 * sectors are 128 KB, NVS needs at least two of them, and the application
 * would lose that space. This part erases in 4 KB sectors.
 *
 * has-lock: the AT25DF family powers up with its block protect bits set, so
 * every write and erase would otherwise go nowhere. The driver clears the bits
 * at start-up — the mask is the Global Unprotect from the datasheet (SPRL plus
 * the four protection bits).
 *
 * CS is a GPIO on PA4 rather than the NSS alternate function: the Zephyr SPI
 * driver drives the line itself.
 *
 * spi-max-frequency is deliberately low for bring-up. The part can do far
 * more, and SPI1 hangs off the 84 MHz APB2.
 */
&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	nor_flash: at25df081a@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		jedec-id = [1f 45 01];
		size = <0x800000>;      /* in bits, not bytes */
		has-lock = <0xbc>;
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * 32 KB = 8 sectors, matching the default of
			 * CONFIG_SETTINGS_NVS_SECTOR_COUNT. The rest of the
			 * part stays free for later.
			 */
			settings_partition: partition@0 {
				label = "settings";
				reg = <0x00000000 DT_SIZE_K(32)>;
			};
		};
	};
};

/*
 * Without this entry the settings' NVS backend would take the
 * storage_partition in the processor board's internal flash. That one stays
 * untouched.
 */
/ {
	chosen {
		zephyr,settings-partition = &settings_partition;
	};
};
