
if SHIELD_FSE_DCU_2612

# Display and LED strip both hang off SPI, the backlight off a timer. All of it
# is shield hardware, so it belongs here rather than in prj.conf.
config SPI
	default y

config PWM
	default y

# DMA transfers for SPI2 (STM32F405RG).
# Takes the pixel transfer off the CPU entirely – the single biggest gain in
# full-refresh speed.
config SPI_STM32_DMA
	default y

if DISPLAY

if LVGL

# Hook the DCU board's rotary encoders up to LVGL.
config LV_Z_ENCODER_INPUT
	default y

config LV_Z_BITS_PER_PIXEL
	default 16

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_16
endchoice

# RGB565 over 8-bit SPI: LVGL has to swap the bytes beforehand (the display
# expects big endian).
config LV_COLOR_16_SWAP
	default y

# Draw buffer size as a percentage of the display area (320x480 = 307,200 bytes).
# A larger buffer means fewer SPI transactions per frame and faster rendering.
#   10 % ~  30 KB  (Zephyr default, the minimum)
#   20 % ~  60 KB  (a good compromise for an STM32F4 with >= 128 KB RAM)
#   50 % ~ 150 KB  (recommended where the RAM exists, e.g. STM32H7)
#  100 % ~ 300 KB  (full framebuffer, tearing impossible)
config LV_Z_VDB_SIZE
	default 20

# Double buffering: LVGL renders into buffer A while DMA sends buffer B.
# Requires SPI_STM32_DMA (enabled above). Doubles the RAM the draw buffer needs
# (2 x LV_Z_VDB_SIZE % of the display area).
# The STM32F405RG has 192 KB of SRAM – at VDB_SIZE=20 the draw buffers take
# 2 x 60 KB = 120 KB, which fits as long as stack and heap stay small.
# config LV_Z_DOUBLE_VDB
# 	default y if SPI_STM32_DMA

endif # LVGL

endif # DISPLAY

endif # SHIELD_FSE_DCU_2612