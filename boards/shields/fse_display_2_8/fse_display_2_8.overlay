/*
 * FSE Display Shield – ST7789V via SPI2
 * SPDX-License-Identifier: Apache-2.0
 *
 * GPIO connections:
 *   CS    -> PA9   (GPIO, active low)
 *   DC    -> PB13  (data/command, active high)
 *   RESET -> PD2   (active low)

 */

#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/display/panel.h>

/ {
	chosen {
		zephyr,display = &st7789v_fse;
	};

	/*
	 * MIPI DBI is the abstraction layer between the Zephyr display API and
	 * the actual SPI bus. It manages the DC GPIO and the reset line.
	 */
	mipi_dbi_fse_display_2_8: mipi_dbi_fse_display_2_8 {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;

		/* DC pin: high = data, low = command */
		dc-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;

		/* Reset: low pulse during init */
		reset-gpios = <&gpiod 2 GPIO_ACTIVE_LOW>;

		/*
		 * write-only: the ST7789V can be read in principle, but most
		 * designs are wired write-only (saves the MISO line). Remove
		 * this if a shield routes MISO through.
		 */
		write-only;

		#address-cells = <1>;
		#size-cells = <0>;

		st7789v_fse: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>; /* CS index: the first entry in cs-gpios */

			/* SPI clock limit of the ST7789V: 20 MHz (the datasheet
			 * allows up to 64 MHz, but 20 MHz is a conservative,
			 * stable value) */
			mipi-max-frequency = <20000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";

			/* Display geometry */
			width = <240>;
			height = <320>;
			x-offset = <0>;
			y-offset = <0>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;

			/* Initialization parameters (from the previous overlay) */
			vcom = <0x2b>;
			gctrl = <0x35>;
			vrhs = <0x0b>;
			vdvs = <0x20>;
			mdac = <0x00>;
			lcm = <0x2c>;
			gamma = <0x01>;
			porch-param = [05 05 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 06 0b 0a 09 05 2e 43 44 09 16 15 23 27];
			nvgam-param = [d0 06 0b 09 08 06 2e 44 44 3a 15 15 23 26];
			ram-param = [00 f8];
			rgb-param = [cd 08 14];
		};
	};
};

/*
 * SPI2 node overlay:
 * - Enables the bus (overriding "disabled" from the board DTS)
 * - Adds cs-gpios (shield specific)
 *
 * cs-gpios is an array – with several SPI devices on the same bus it takes
 * several entries, and the devices carry reg = <0>, <1>, ... accordingly.
 */
&spi2 {
	/*
	 * 2.8": connector pin 31 = SCK -> PB13, pin 32 = DC -> PB10.
	 * On the 3.5" display those two pins are exactly the other way round,
	 * which is why each display shield brings its own pin assignment and
	 * overrides the board DTS default with it.
	 */
	pinctrl-0 = <&spi2_sck_pb13 &spi2_mosi_pc3 &spi2_miso_pc2>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 12 GPIO_ACTIVE_LOW>;
	status = "okay";
};