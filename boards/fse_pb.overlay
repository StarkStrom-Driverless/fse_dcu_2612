/*
 * Applikations-Overlay für das Board fse_pb.
 *
 * Hier steht nur noch, was auf dem Prozessorboard sitzt, aber im Board-DTS
 * noch fehlt.  DCU-Hardware — Display, Encoder, Taster, Piezo, LED-Streifen —
 * liegt im Shield fse_dcu_2612.
 *
 * ── Offen: gehört ins Board-Repo ─────────────────────────────────────────────
 *
 * Die TJA1048-Transceiver sind auf dem Prozessorboard verlötet und damit für
 * jedes Projekt gleich.  Sobald die Knoten in boards/ss/fse_pb/fse_pb.dts
 * stehen, kann dieses Overlay ersatzlos entfallen.
 */

/ {
	can_phy0: can_phy0 {
		compatible = "can-transceiver-gpio";
		/* TJA1048: STB LOW = Standby, STB HIGH = Normal → ACTIVE_LOW */
		standby-gpios = <&gpiob 7 GPIO_ACTIVE_LOW>;
		max-bitrate = <1000000>;
		#phy-cells = <0>;
	};

	can_phy1: can_phy1 {
		compatible = "can-transceiver-gpio";
		standby-gpios = <&gpiob 4 GPIO_ACTIVE_LOW>;
		max-bitrate = <1000000>;
		#phy-cells = <0>;
	};
};

&can1 {
	phys = <&can_phy0>;
};

&can2 {
	phys = <&can_phy1>;
};
