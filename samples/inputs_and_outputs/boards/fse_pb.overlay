#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/lvgl/lvgl.h>

/ {
    aliases {
        qdec-input-left = &lvgl_encoder0;
        qdec-input-right = &lvgl_encoder1;
        keypad-left = &keypad_left;
        keypad-right = &keypad_right;
        pwm-pizeo = &pwm_piezo;
    };

    pwmleds {
		compatible = "pwm-leds";

		pwm_piezo: pwm_piezo {
			pwms = <&pwm3 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

    qdec_input0: qdec-encoder0 {
        compatible = "gpio-qdec";
        gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>,
                <&gpioc 7 GPIO_ACTIVE_HIGH>;
        steps-per-period = <2>;
        zephyr,axis = <INPUT_REL_WHEEL>;
        sample-time-us = <2000>;
        idle-timeout-ms = <200>;
        status = "okay";
    };

    qdec_input1: qdec-encoder1 {
        compatible = "gpio-qdec";
        gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>,
                <&gpioa 1 GPIO_ACTIVE_HIGH>;
        steps-per-period = <2>;
        zephyr,axis = <INPUT_REL_HWHEEL>;
        sample-time-us = <2000>;
        idle-timeout-ms = <200>;
        status = "okay";
    };

    lvgl_encoder0: lvgl-encoder0 {
		status = "okay";
        compatible = "zephyr,lvgl-encoder-input";
        rotation-input-code = <INPUT_REL_WHEEL>;
    };

    lvgl_encoder1: lvgl-encoder1 {
		status = "okay";
        compatible = "zephyr,lvgl-encoder-input";
        rotation-input-code = <INPUT_REL_HWHEEL>;
    };

    buttons0: gpio_keys0 {
		compatible = "gpio-keys";
		left_button: button_1 {
			gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
    };

    buttons1: gpio_keys1 {
		compatible = "gpio-keys";
		right_button: button_2 {
			gpios = <&gpioc 14 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
    };

    keypad_left: keypad0 {
		compatible = "zephyr,lvgl-keypad-input";
		input = <&buttons0>;
		input-codes = <INPUT_KEY_ENTER>;
		lvgl-codes = <LV_KEY_ENTER>;
	};

    keypad_right: keypad1 {
		compatible = "zephyr,lvgl-keypad-input";
		input = <&buttons1>;
		input-codes = <INPUT_KEY_ENTER>;
		lvgl-codes = <LV_KEY_ENTER>;
	};
};

&timers3 {
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch4_pb1>;
		pinctrl-names = "default";
	};
};